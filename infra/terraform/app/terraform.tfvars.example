aws_region   = "ap-northeast-1"
project_name = "discord-translation-bot"
environment  = "prod"
vpc_cidr_block = "10.40.0.0/16"

# Provision infrastructure without starting a task. Change to 1 after the
# image is pushed and both SSM SecureString parameters have been created.
desired_count = 0
image_tag     = "bootstrap"

# Create these parameters in AWS Systems Manager Parameter Store as SecureString.
# Terraform stores only their names/ARNs, never their values.
discord_token_parameter_name    = "/discord-translation-bot/prod/DISCORD_TOKEN"
gemini_api_key_parameter_name = "/discord-translation-bot/prod/GEMINI_API_KEY"

# Optional. Set only when the SecureString parameters use a customer-managed KMS key.
# secret_kms_key_arn = "arn:aws:kms:ap-northeast-1:123456789012:key/replace-me"
